
# Multi-Agent MLOps Platform : Environment Variables

# App 
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO
DEBUG=true

# MLflow 
# Local dev: uses the docker-compose MLflow container
# Production: change to your Kubernetes service URL
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=multi-agent-mlops
MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts/mlflow

# Cloudflare R2 (free tier: 10 GB storage, 10M Class-B reads) 
# Get these from: Cloudflare Dashboard → R2 → Manage API tokens
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_ENDPOINT_URL=https://<YOUR_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET_NAME=mlflow-artifacts
R2_REGION=auto

# Neon PostgreSQL (free tier: 0.5 GB, 191.9 compute-hours) 
# Get from: https://console.neon.tech → your project → Connection Details
# Format: postgresql+asyncpg://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require


# Oracle Cloud K3s (Always-Free ARM VMs) 
K8S_IN_CLUSTER=false         # set to true when running inside the cluster
K8S_NAMESPACE=mlops

# LLM Provider (choose one) 
# OpenAI (gpt-4o-mini is cheapest for agent reasoning)
OPENAI_API_KEY=sk-...

# OR Anthropic (claude-3-haiku-20240307 is cost-efficient)
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-3-haiku-20240307

LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# Cloudflare Budget Monitoring 
# Cloudflare Dashboard → My Profile → API Tokens → Create Token
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Neon Budget Monitoring 
# https://console.neon.tech → Account → API Keys
NEON_API_KEY=your_neon_api_key_here 
NEON_PROJECT_ID=your_neon_project_id_here

# Agent Safety Limits 
AGENT_MAX_ITERATIONS=20
AGENT_MAX_TOOL_CALLS=50
AGENT_TASK_TIMEOUT_SECONDS=120
AGENT_MAX_CONCURRENT=10

# Monitoring 
GRAFANA_ADMIN_PASSWORD=admin   # change in production!
GRAFANA_URL=http://localhost:3001
LOKI_URL=http://localhost:3100

# Slack (optional — budget alerts) 
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# GitHub OAuth (optional — UI auth) 
# GITHUB_CLIENT_ID=your_github_oauth_app_client_id
# GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
# OAUTH2_COOKIE_SECRET=a_random_32_char_secret_for_cookie_signing

# Feature Store (Feast) 
FEAST_REPO_PATH=./feast

# RL Agent 
RL_MODEL_PATH=/models/rl_optimizer
RL_TRAINING_TIMESTEPS=10000

# OpenTelemetry Tracing 
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
